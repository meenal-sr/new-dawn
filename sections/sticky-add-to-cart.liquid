{%- if section.settings.enable_sticky_banner and product != blank -%}
  
  {{ 'sticky-add-to-cart.css' | asset_url | stylesheet_tag }}

  <sticky-add-to-cart class="sticky-cart-modal">
    <div class="container sticky-container">
      <div class="sticky-cart-modal-inner-wrap">
        
        <!-- Product Info Block -->
        <div class="product_sticky__info">
          {%- if product.featured_image != blank -%}
            {{ product.featured_image | image_url: width: 100 | image_tag: alt: product.title, loading: 'lazy' }}
          {%- endif -%}
          <h2>{{ product.title }}</h2>
          <div class="product-price" data-product-block-container>
            {{ product.selected_or_first_available_variant.price | money }}
          </div>
        </div>

        <!-- Quantity & ATC Form Block -->
        <div class="quantity_addtocart_btn product_quantity_button" id="original-sticky-actions">
          {%- form 'product', product, id: 'StickyAddToCartForm' -%}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            
            <div class="sticky-qty-selector">
              <button type="button" class="qty-btn minus" aria-label="Decrease quantity">-</button>
              <input type="number" name="quantity" value="1" min="1" class="qty-input" id="sticky-qty" />
              <button type="button" class="qty-btn plus" aria-label="Increase quantity">+</button>
            </div>
            <button type="submit" name="add" class="sticky-add-btn">Add to cart</button>
          {%- endform -%}
        </div>

      </div>
    </div>
  </sticky-add-to-cart>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Hardcoded selector for your main Add to Cart button
      const mainAtcButton = document.querySelector('button[name="add"]'); 
      const stickyBanner = document.querySelector('sticky-add-to-cart');

      if (mainAtcButton && stickyBanner) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) {
              stickyBanner.classList.add('show-modal');
            } else {
              stickyBanner.classList.remove('show-modal');
            }
          });
        }, {
          root: null,
          threshold: 0
        });

        observer.observe(mainAtcButton);
      }

      // Quantity Selector Logic
      const qtyContainer = document.querySelector('.sticky-qty-selector');
      if (qtyContainer) {
        const qtyInput = qtyContainer.querySelector('.qty-input');
        const minusBtn = qtyContainer.querySelector('.minus');
        const plusBtn = qtyContainer.querySelector('.plus');

        minusBtn.addEventListener('click', () => {
          let currentValue = parseInt(qtyInput.value) || 1;
          if (currentValue > 1) {
            qtyInput.value = currentValue - 1;
          }
        });

        plusBtn.addEventListener('click', () => {
          let currentValue = parseInt(qtyInput.value) || 1;
          qtyInput.value = currentValue + 1;
        });
      }
    });
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Sticky Add to Cart",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_sticky_banner",
      "label": "Enable Sticky Banner",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Sticky Add to Cart"
    }
  ]
}
{% endschema %}