<!-- 1. Swiper CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@14.0.1/swiper-bundle.min.css" />
{{ 'powerful-benefits.css' | asset_url | stylesheet_tag }}

<section class="powerful-benefits-section">
  <div class="pb-container">
    <div class="pb-inner-card">
    
      <!-- HEADER -->
      <h2 class="pb-main-title">powerful benefits</h2>
      <!-- This title updates automatically via JS when the carousel swipes -->
      <h3 class="pb-product-title" id="pb-active-title">
        {% if section.blocks.size > 0 %}
          {{ section.blocks.first.settings.product.title | downcase }}
        {% endif %}
      </h3>

      <!-- CAROUSEL (Updated to Swiper Structure) -->
      <div class="pb-carousel-wrapper">
        <div class="swiper mySwiper" id="pb-carousel">
          <div class="swiper-wrapper">
            {% for block in section.blocks %}
              {% assign product = block.settings.product %}
              {% if product != blank %}
                <div class="swiper-slide pb-carousel-slide" data-index="{{ forloop.index0 }}" data-title="{{ product.title | downcase }}">
                  <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title }}">
                </div>
              {% endif %}
            {% endfor %}
          </div>
          
          <!-- Swiper Scrollbar -->
          <div class="swiper-scrollbar pb-swiper-scrollbar"></div>
        </div>
      </div>

      <!-- ACCORDIONS (Unchanged) -->
      <div class="pb-accordions-container">
        {% for block in section.blocks %}
          {% assign product = block.settings.product %}
          
          {% if product != blank %}
            {% assign benefits_list = product.metafields.custom.powerful_benefits_metafield.value %}
            
            <!-- Only the active product's group is visible on load -->
            <div class="pb-accordion-group {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}">
              
              <!-- 2. Loop through the metafield items dynamically -->
              {% for item in benefits_list %}
                <div class="pb-accordion-item">
                  
                  <button type="button" class="pb-accordion-btn">
                    <span class="pb-accordion-btn-left">
                      
                      {% if item.icon != blank %}
                          {{ item.icon | image_url: width: 24 | image_tag: alt: item.title, class: 'pb-accordion-icon' }}
                      {% endif %}
                      
                      <!-- Dynamic Title from Metafield -->
                      {{ item.title | downcase }}
                    </span>
                    
                    <span class="pb-accordion-arrow">
                      <svg width="12" height="8" viewBox="0 0 14 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M1 1L7 7L13 1" stroke="#304b7d" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                  </button>
                  
                  <div class="pb-accordion-content">
                    <div class="pb-accordion-inner">
                      <!-- Dynamic Content/Description from Metafield -->
                      {{ item.desc | metafield_tag }}
                    </div>
                  </div>
                  
                </div>
              {% endfor %}

            </div>
          {% endif %}
        {% endfor %}
      </div>

    </div>
  </div>
</section>

<!-- 2. Swiper JS loaded right before our initialization -->
<script src="https://cdn.jsdelivr.net/npm/swiper@14.0.1/swiper-bundle.min.js"></script>

<!-- The custom drag and sync script (Updated for Swiper 3D) -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Timeout ensures Swiper library is ready in Shopify
    setTimeout(() => {
      const titleEl = document.getElementById('pb-active-title');
      const accordionGroups = document.querySelectorAll('.pb-accordion-group');
      
      // Initialize Swiper with 3D Coverflow
      var swiper = new Swiper('.mySwiper', {
        effect: 'coverflow', 
        grabCursor: true,
        centeredSlides: true,
        slidesPerView: 'auto', 
        slideToClickedSlide: true,
        observer: true,           // Auto-renders scrollbar once images mount
        observeParents: true,
        watchSlidesProgress: true,
        
        coverflowEffect: {
          rotate: 0,       
          stretch: 0,    
          depth: 200,      // Pushes side bottles backward
          modifier: 1,     
          slideShadows: false, 
        },
        
        // Swiper Scrollbar
        scrollbar: {
          el: '.swiper-scrollbar',
          hide: false, 
          draggable: true,
        },

        // Responsive Breakpoints
        breakpoints: {
          1200: {
            effect: 'slide',
            centeredSlides: false,
            slidesPerView: 3,
            spaceBetween: 30,
            allowTouchMove: false
          }
        },

        // Sync logic
        on: {
          slideChange: function () {
            const activeIndex = this.realIndex;
            const activeSlide = this.slides[activeIndex];
            
            // Update Title
            if (activeSlide && titleEl) {
              titleEl.textContent = activeSlide.dataset.title;
            }

            // Swap Accordion Groups
            accordionGroups.forEach((group, i) => {
              group.classList.toggle('is-active', i === activeIndex);
            });
          }
        }
      });

      // Direct Click on Slides for Desktop & Touch
      const slides = document.querySelectorAll('.pb-carousel-slide');
      slides.forEach((slide, index) => {
        slide.addEventListener('click', () => {
          swiper.slideTo(index);
          slides.forEach((s, i) => s.classList.toggle('swiper-slide-active', i === index));
          if (titleEl) {
            titleEl.textContent = slide.dataset.title;
          }
          accordionGroups.forEach((group, i) => {
            group.classList.toggle('is-active', i === index);
          });
        });
      });

      // Accordion Click Logic
      // Accordion Click Logic (Independent Toggle)
      const accordionBtns = document.querySelectorAll('.pb-accordion-btn');
      accordionBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          const item = this.closest('.pb-accordion-item');
          item.classList.toggle('is-open');
        });
      });
    }, 100); 
  });
</script>

{% schema %}
{
  "name": "Powerful Benefits",
  "settings": [],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Powerful Benefits",
      "blocks": [
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}