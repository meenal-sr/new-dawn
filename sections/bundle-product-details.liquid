{{ 'bundle-product-details.css' | asset_url | stylesheet_tag }}

{% assign selected_product = blank %}

{% for block in section.blocks %}
  {% if block.settings.product != blank %}
    {% assign selected_product = block.settings.product %}
    {% break %}
  {% endif %}
{% endfor %}
<section class="bundle-product-details-section">

  <div class="bundle-product-details">

    <!-- LEFT SIDE -->
    <div class="bundle-product-details__products">

      <h3>Select a product to view details</h3>

      <div class="bundle-product-list">

        {% for block in section.blocks %}
          {% assign product = block.settings.product %}

          {% if product != blank %}

            {% assign product_details = product.metafields.custom.stress_complx_metafield_left.value %}

            <div
              class="bundle-product-card{% if product.id == selected_product.id %} bundle-product-card--active{% endif %}"
              data-product-id="{{ product.id }}"
              {{ block.shopify_attributes }}>

              {% if product.featured_image %}
                <div class="bundle-product-card__image">
                  {{
                    product.featured_image | image_url: width: 300 | image_tag: widths: '100, 150, 200, 300', sizes: '150px', loading: 'lazy', alt: product.featured_image.alt | default: product.title | escape
                  }}
                </div>
              {% endif %}

              <div class="bundle-product-card__info">

  <h4>
    {{ product.title }}
  </h4>

  {% for item in product_details %}
    {% if item.strength != blank %}
      <span class="bundle-product-card__strength">
        {{ item.strength }}
      </span>
    {% endif %}
  {% endfor %}

</div>

{% if product.url != blank %}
  <a
    href="{{ product.url }}"
    class="bundle-product-card__link"
  >
    View product ↗
  </a>
{% endif %}

            </div>

          {% endif %}
        {% endfor %}

      </div>

    </div>


    <!-- RIGHT SIDE -->
    <div class="bundle-product-details__content">

      {% if selected_product != blank %}

        <div class="bundle-product-details__tabs">

          <button
            type="button"
            class="bundle-tab active"
            onclick="openBundleTab(event, 'benefits')">
            Benefits
          </button>

          <button
            type="button"
            class="bundle-tab"
            onclick="openBundleTab(event, 'ingredients')">
            Ingredients
          </button>

          <button
            type="button"
            class="bundle-tab"
            onclick="openBundleTab(event, 'how-to-use')">
            How to use
          </button>

          <button
            type="button"
            class="bundle-tab"
            onclick="openBundleTab(event, 'safety')">
            Safety
          </button>

        </div>


        <div class="bundle-product-details__tab-content">

          {% for block in section.blocks %}

            {% assign product = block.settings.product %}

            {% if product != blank %}

              {% assign product_details_right = product.metafields.custom.stress_complx_metafield_right.value %}

              <div class="bundle-product-content{% if product.id == selected_product.id %} bundle-product-content--active{% endif %}" data-product-content="{{ product.id }}">

                <div id="benefits-{{ product.id }}" class="bundle-tab-content">
                  {% for item in product_details_right %}
                    {{ item.benefits | metafield_tag }}
                  {% endfor %}
                </div>


                <div id="ingredients-{{ product.id }}" class="bundle-tab-content">
                  {% for item in product_details_right %}
                    {{ item.ingredients | metafield_tag }}
                  {% endfor %}
                </div>


                <div id="how-to-use-{{ product.id }}" class="bundle-tab-content">
                  {% for item in product_details_right %}
                    {{ item.how_to_use | metafield_tag }}
                  {% endfor %}
                </div>


                <div id="safety-{{ product.id }}" class="bundle-tab-content">
                  {% for item in product_details_right %}
                    {{ item.safety | metafield_tag }}
                  {% endfor %}
                </div>

              </div>

            {% endif %}

          {% endfor %}

        </div>

      {% endif %}

    </div>

  </div>
</section>

<script>
  function openBundleTab(event, tabName) {

    var tabLinks = document.querySelectorAll('.bundle-tab');
    var tabContent = document.querySelectorAll('.bundle-tab-content');

    for (var i = 0; i < tabLinks.length; i++) {
      tabLinks[i].classList.remove('active');
    }

    for (var i = 0; i < tabContent.length; i++) {
      tabContent[i].style.display = 'none';
    }

    event.currentTarget.classList.add('active');

    var activeProduct = document.querySelector(
      '.bundle-product-content--active'
    );

    if (activeProduct) {
      var selectedContent = activeProduct.querySelector(
        '[id^="' + tabName + '-"]'
      );

      if (selectedContent) {
        selectedContent.style.display = 'block';
      }
    }
  }


  document.addEventListener('DOMContentLoaded', function () {

    var productCards = document.querySelectorAll(
      '.bundle-product-card'
    );

    productCards.forEach(function (card) {

      card.addEventListener('click', function () {

        var productId = card.dataset.productId;

        var productContents = document.querySelectorAll(
          '.bundle-product-content'
        );

        productCards.forEach(function (item) {
          item.classList.remove(
            'bundle-product-card--active'
          );
        });

        productContents.forEach(function (content) {
          content.classList.remove(
            'bundle-product-content--active'
          );
        });

        card.classList.add(
          'bundle-product-card--active'
        );

        var selectedProductContent = document.querySelector(
          '[data-product-content="' + productId + '"]'
        );

        if (selectedProductContent) {
          selectedProductContent.classList.add(
            'bundle-product-content--active'
          );
        }

        var activeTab = document.querySelector(
          '.bundle-tab.active'
        );

        if (activeTab) {
          var tabName = activeTab.textContent
            .trim()
            .toLowerCase()
            .replace(' ', '-');

          var selectedTabContent =
            selectedProductContent.querySelector(
              '[id^="' + tabName + '-"]'
            );

          document
            .querySelectorAll('.bundle-tab-content')
            .forEach(function (content) {
              content.style.display = 'none';
            });

          if (selectedTabContent) {
            selectedTabContent.style.display = 'block';
          }
        }

      });

    });

  });
</script>

{% schema %}
  {
    "name": "Bundle product details",
    "settings": [],
    "blocks": [
      {
        "type": "product",
        "name": "Product",
        "settings": [
          {
            "type": "product",
            "id": "product",
            "label": "Product"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Bundle product details",
        "blocks": [
          {
            "type": "product"
          }, {
            "type": "product"
          }, {
            "type": "product"
          }
        ]
      }
    ]
  }
{% endschema %}