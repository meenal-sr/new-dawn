{%- if product.metafields.custom.product_ingred_metafield != blank -%}

  {{ 'key-ingredients.css' | asset_url | stylesheet_tag }}

  <div class="section-template--bundle_key_ingredients_main section-key-ingredients">
    <div class="container container--page-width section-spacing">
      
      <!-- Section Header with Arrows -->
      <div class="main_title_key key-list__header--center">
        <button type="button" class="carousel-btn carousel-prev" disabled aria-label="Previous slide">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M7.5 9L4.5 6L7.5 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        
        <h2>{{ section.settings.heading }}</h2>
        
        <button type="button" class="carousel-btn carousel-next" aria-label="Next slide">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M4.5 9L7.5 6L4.5 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>

      <!-- Carousel Wrapper -->
      <carousel-component class="card-carousel key-ingredients card-carousel--with-half-next-slide">
        <div class="card-carousel__viewport card-carousel__viewport--overflow" data-carousel-viewport>
          <div class="card-carousel__container announcement__carousel-container" data-carousel-container>
            
            {%- for ingredient in product.metafields.custom.product_ingred_metafield.value -%}
              <div class="card-carousel__slide {% if forloop.first %}is-selected{% endif %}">
                <div class="ingredients_wrapper">
                  
                  <!-- Top Section: Image and Title -->
                  <div class="img_wrap_text_info">
                    <div class="img_wrap">
                      {%- if ingredient.icon != blank -%}
                        {{ ingredient.icon | image_url: width: 200 | image_tag: alt: ingredient.title, loading: 'lazy' }}
                      {%- endif -%}
                    </div>
                    
                    <div class="key_ingre_title">
                      {%- if ingredient.badge != blank -%}
                        <span class="badge">{{ ingredient.badge }}</span>
                      {%- endif -%}
                      <h3>{{ ingredient.ingredient }}</h3>
                    </div>
                  </div>

                  <!-- Bottom Section: Description -->
                  <div class="key_ingre_description">
                    <p>
                      {{ ingredient.description | truncate: 200 }}
                      {%- if ingredient.link != blank -%}
                        <a href="{{ ingredient.link }}">Read more &gt;</a>
                        
                      {%- endif -%}
                    </p>
                  </div>

                </div>
              </div>
            {%- endfor -%}
            
          </div>
        </div>
      </carousel-component>
      
    </div>
  </div>

  <script>
    if (!customElements.get('carousel-component')) {
      customElements.define('carousel-component', class CarouselComponent extends HTMLElement {
        constructor() {
          super();
          this.viewport = this.querySelector('[data-carousel-viewport]');
          this.section = this.closest('.section-key-ingredients');
          this.prevBtn = this.section.querySelector('.carousel-prev');
          this.nextBtn = this.section.querySelector('.carousel-next');

          if (!this.viewport || !this.prevBtn || !this.nextBtn) return;

          this.prevBtn.addEventListener('click', () => this.scroll(-1));
          this.nextBtn.addEventListener('click', () => this.scroll(1));
          this.viewport.addEventListener('scroll', this.updateButtons.bind(this));
          
          this.updateButtons();
          window.addEventListener('resize', this.updateButtons.bind(this));
        }

        scroll(direction) {
          const slide = this.querySelector('.card-carousel__slide');
          if (!slide) return;
          const scrollAmount = slide.clientWidth + 24; 
          this.viewport.scrollBy({ left: scrollAmount * direction, behavior: 'smooth' });
        }

        updateButtons() {
          this.prevBtn.disabled = this.viewport.scrollLeft <= 0;
          const isAtEnd = Math.ceil(this.viewport.scrollLeft + this.viewport.clientWidth) >= (this.viewport.scrollWidth - 2);
          this.nextBtn.disabled = isAtEnd;
        }
      });
    }
  </script>

{%- endif -%}

{% schema %}
{
  "name": "Key Ingredients Carousel",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "key ingredients"
    }
  ],
  "presets": [
    {
      "name": "Key Ingredients Carousel"
    }
  ],
  "templates": [
    "product"
  ]
}
{% endschema %}